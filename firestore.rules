rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // --- Entity Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'fourColorDeck',
          'soundEnabled',
          'totalDecisions',
          'optimalCount',
          'totalEvLossBb',
          'currentStreak',
          'bestStreak',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'fourColorDeck',
          'soundEnabled',
          'totalDecisions',
          'optimalCount',
          'totalEvLossBb',
          'currentStreak',
          'bestStreak',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 64
        && data.fourColorDeck is bool
        && data.soundEnabled is bool
        && data.totalDecisions is int
        && data.totalDecisions >= 0
        && data.totalDecisions <= 1000000
        && data.optimalCount is int
        && data.optimalCount >= 0
        && data.optimalCount <= data.totalDecisions
        && data.totalEvLossBb is number
        && data.totalEvLossBb >= 0
        && data.totalEvLossBb <= 1000000
        && data.currentStreak is int
        && data.currentStreak >= 0
        && data.currentStreak <= 1000000
        && data.bestStreak is int
        && data.bestStreak >= data.currentStreak
        && data.bestStreak <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDrillAttempt(data) {
      return data.keys().hasAll([
          'uid',
          'module',
          'position',
          'street',
          'spotLabel',
          'chosenAction',
          'bestAction',
          'evLossBb',
          'grade',
          'accuracyScore',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'module',
          'position',
          'street',
          'spotLabel',
          'chosenAction',
          'bestAction',
          'evLossBb',
          'grade',
          'accuracyScore',
          'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.module is string
        && data.module in ['preflop', 'postflop', 'math', 'reading', 'table']
        && data.position is string
        && data.position in ['UTG', 'HJ', 'CO', 'BTN', 'SB', 'BB', 'ALL']
        && data.street is string
        && data.street in ['preflop', 'flop', 'turn', 'river', 'math']
        && data.spotLabel is string
        && data.spotLabel.size() >= 1
        && data.spotLabel.size() <= 120
        && data.chosenAction is string
        && data.chosenAction.size() >= 1
        && data.chosenAction.size() <= 64
        && data.bestAction is string
        && data.bestAction.size() >= 1
        && data.bestAction.size() <= 64
        && data.evLossBb is number
        && data.evLossBb >= 0
        && data.evLossBb <= 200
        && data.grade is string
        && data.grade in ['Optimal', 'Acceptable', 'Inaccuracy', 'Mistake', 'Blunder']
        && data.accuracyScore is number
        && data.accuracyScore >= 0
        && data.accuracyScore <= 100
        && data.createdAt is timestamp;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update study preferences
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'fourColorDeck', 'soundEnabled', 'updatedAt'])
          ||
          // Action 2: Sync mastery counters
          incoming().diff(existing()).affectedKeys().hasOnly([
            'totalDecisions',
            'optimalCount',
            'totalEvLossBb',
            'currentStreak',
            'bestStreak',
            'updatedAt'
          ])
          ||
          // Action 3: Combined profile + stats sync
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'fourColorDeck',
            'soundEnabled',
            'totalDecisions',
            'optimalCount',
            'totalEvLossBb',
            'currentStreak',
            'bestStreak',
            'updatedAt'
          ])
        );

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- Subcollection: /users/{userId}/attempts/{attemptId} ---
      match /attempts/{attemptId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        // Pillar 8: Secure List Query without get() calls
        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && isValidDrillAttempt(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if false;

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
